NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/byklea
# Random, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
# Number of reverse proxies in front of the app (e.g. 1 behind a load balancer). Leave empty when none.
TRUST_PROXY=

SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=your_email_here
SMTP_PASS=your_app_password_here
MAIL_FROM=

OPENAI_API_KEY=your_api_key_here
# Sent by Dialogflow in the X-Webhook-Secret header. Generate the same way as JWT_SECRET.
DIALOGFLOW_WEBHOOK_SECRET=your_webhook_secret_here
